# ─── API ──────────────────────────────────────────────────────────────────────
# Desarrollo local:
VITE_API_URL=http://localhost:5000/api
# Producción (Railway): descomenta y pon la URL de tu servicio backend
# VITE_API_URL=https://tu-backend.up.railway.app/api

# ─── Wompi (pagos) ────────────────────────────────────────────────────────────
# Sandbox (pruebas): https://sandbox.wompi.co → Configuración → Llaves de API
# Producción: https://comercios.wompi.co → Configuración → Llaves de API
VITE_WOMPI_PUBLIC_KEY=
VITE_WOMPI_CURRENCY=COP
# Firma de integridad (sha256 de: referencia + monto_en_centavos + moneda + llave_privada)
# Para sandbox puedes dejarla vacía; para producción es OBLIGATORIA.
VITE_WOMPI_SIGNATURE_INTEGRITY=
# Página a la que Wompi redirige al cliente después del pago
VITE_WOMPI_REDIRECT_URL=https://tu-frontend.vercel.app/mi-cuenta

# ─── WhatsApp de ventas ───────────────────────────────────────────────────────
# Número en formato internacional sin + ni espacios.  Ej: 573001234567
VITE_WHATSAPP_SALES_NUMBER=573002454123
