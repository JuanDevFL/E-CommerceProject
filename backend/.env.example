# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # cambiar a "production" en Railway

# ─── Base de datos (Railway MySQL o local) ────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=.
DB_NAME=ecommerce_db
MYSQLDATABASE=
MYSQLHOST=
MYSQLPASSWORD=
MYSQLPORT=
MYSQLUSER=
MYSQL_URL=

# En Railway estas vars las provee el plugin MySQL automáticamente:
#   MYSQLHOST  MYSQLPORT  MYSQLUSER  MYSQLPASSWORD  MYSQLDATABASE
# Puedes renombrarlas en el panel de Railway o alias en db.js.

# ─── JWT ──────────────────────────────────────────────────────────────────────
# PRODUCCIÓN: genera dos valores aleatorios con `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`
JWT_SECRET=azami-local-dev-secret
JWT_REFRESH_SECRET=azami-refresh-local-dev-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Pon aquí el dominio exacto de Vercel (sin / al final).
# Múltiples dominios separados por coma.
# Ejemplo: ALLOWED_ORIGINS=https://azami.vercel.app,https://www.azami.com
ALLOWED_ORIGINS=

# ─── Wompi (backend seguro) ───────────────────────────────────────────────────
# La firma de integridad debe generarse en el backend, nunca en el frontend.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
# Secreto de eventos/webhook (Dashboard Wompi -> Mi cuenta -> Secretos integración técnica)
WOMPI_EVENTS_SECRET=
WOMPI_CURRENCY=COP
# Ejemplo: https://tu-frontend.vercel.app/checkout
WOMPI_REDIRECT_URL=

# ─── App / emails transaccionales ─────────────────────────────────────────────
FRONTEND_APP_URL=http://localhost:5173
STOREFRONT_NAME=Azami
RESEND_API_KEY=
RESEND_FROM_EMAIL=Azami <notificaciones@tu-dominio.com>

# ─── Logs ─────────────────────────────────────────────────────────────────────
LOG_API_REQUESTS=true
LOG_AUTH_PAYLOAD=false

# ─── Modo de autenticación (database | mock) ──────────────────────────────────
AUTH_LOGIN_MODE=database

# ─── Usuarios mock para desarrollo (no se usan en producción) ─────────────────
MOCK_ADMIN_ID=9001
MOCK_ADMIN_NAME=Admin Azami Test
MOCK_ADMIN_EMAIL=admin.test@azami.com
MOCK_ADMIN_PASSWORD=AdminTest2026!
MOCK_ADMIN_ROLE=admin
MOCK_USER_ID=9002
MOCK_USER_NAME=Cliente Azami Test
MOCK_USER_EMAIL=cliente.test@azami.com
MOCK_USER_PASSWORD=ClienteTest2026!
MOCK_USER_ROLE=user

# ─── Seeds ────────────────────────────────────────────────────────────────────
SEED_ADMIN_NAME=Admin Azami
SEED_ADMIN_EMAIL=admin@azami.com
SEED_ADMIN_PASSWORD=AdminAzami2026!
SEED_USER_NAME=Cliente Azami
SEED_USER_EMAIL=cliente@azami.com
SEED_USER_PASSWORD=ClienteAzami2026!
